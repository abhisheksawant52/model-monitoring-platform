# Service
MM_APP_NAME=model-monitoring-platform
MM_ENVIRONMENT=development
MM_HOST=0.0.0.0
MM_PORT=8000
MM_LOG_LEVEL=INFO

# Drift thresholds
MM_PSI_WARN_THRESHOLD=0.1
MM_PSI_ALERT_THRESHOLD=0.25
MM_KS_PVALUE_THRESHOLD=0.05

# Performance thresholds
MM_MIN_ACCURACY=0.80
MM_MAX_LATENCY_MS_P95=250
MM_ROLLING_WINDOW=1000

# Baseline storage (S3)
MM_BASELINE_BUCKET=model-monitoring-baselines
MM_BASELINE_PREFIX=baselines/
MM_AWS_REGION=us-east-1

# Alerting (leave blank to disable)
MM_ALERT_SNS_TOPIC_ARN=
MM_ALERT_WEBHOOK_URL=
